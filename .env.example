APP_NAME=Oikolog
APP_ENV=production
## Generate a base64 APP_KEY for Laravel (run `php artisan key:generate` locally).
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Athens

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oikolog
DB_USERNAME=oikolog
DB_PASSWORD=secret

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# Idle timeout of one session, in minutes. "Remember me" keeps someone signed
# in across it for SESSION_REMEMBER_LIFETIME minutes (400 days).
SESSION_LIFETIME=10080
SESSION_REMEMBER_LIFETIME=576000

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080

FILESYSTEM_DRIVER=public

# The deployment's admin account. `php artisan admin:reset-password` uses it
# and prints a generated password when none is given.
ADMIN_EMAIL=admin@oikolog.local

VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
