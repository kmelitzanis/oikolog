vendor
node_modules
npm-debug.log
.env
.env.*
storage/*.key
/public/storage
/storage/*.key
.DS_Store
.git

# Generated at build time by composer's package:discover. Copying a local one in
# ships a manifest that lists dev-only providers (Collision) which --no-dev then
# does not install, and the app cannot boot.
bootstrap/cache/*.php

/design-system

# Local build output and vulnerability reports are not application inputs.
/public/build
/public/hot
scout-report*.md
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
